# Copy this file to .env (or .env.local) and fill in your key.
# Get a free key in under a minute at https://api.nasa.gov
# Without it the app falls back to DEMO_KEY (about 30 requests/hour, 50/day per IP).
#
# Note: every VITE_* variable is bundled into the client JavaScript, so this key
# is visible to anyone who opens the site. That's expected for api.nasa.gov keys.
VITE_NASA_API_KEY=
